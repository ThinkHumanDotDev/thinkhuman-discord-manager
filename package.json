{
  "name": "thinkhuman-discord-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd packages/api dev",
    "dev:bot": "bun run --cwd packages/bot dev",
    "dev:frontend": "bun run --cwd packages/frontend dev",
    "deploy:api": "bun run --cwd packages/api deploy",
    "deploy:bot": "bun run --cwd packages/bot deploy",
    "deploy:frontend": "bun run --cwd packages/frontend deploy",
    "type-check": "tsc -b packages/api/tsconfig.json packages/bot/tsconfig.json packages/frontend/tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@thinkhuman/biome-config": "github:ThinkHumanDotDev/biome-config#v1.4.0",
    "typescript": "~5.8.0"
  }
}
